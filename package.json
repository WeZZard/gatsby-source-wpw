{
  "name": "@wezzard/wpw",
  "version": "2.0.0",
  "type": "module",
  "description": "Shared MyWorks content domain model, Remark AST utilities, and Astro 5 Content Layer loaders for WeZZard Personal Works",
  "author": "WeZZard <me@wezzard.com>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/WeZZard/gatsby-source-wpw.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    },
    "./remark": {
      "types": "./dist/remark/index.d.ts",
      "import": "./dist/remark/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/__tests__/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "astro": "^5.0.0",
    "sharp": "^0.33.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "astro": "^5.5.0",
    "sharp": "^0.33.5",
    "typescript": "^5.8.2"
  }
}
